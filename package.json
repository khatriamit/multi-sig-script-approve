{
  "name": "safe-multisig-automation",
  "version": "1.0.0",
  "description": "Automated 2-of-3 multisig transactions using Safe Protocol",
  "main": "servers/src/config.ts",
  "scripts": {
    "build": "tsc",
    "start": "ts-node servers/src/coordinator.ts",
    "server:initate": "ts-node servers/src/coordinator.ts",
    "server:signer-1": "ts-node servers/src/signer-server-1.ts",
    "server:signer-2": "ts-node servers/src/signer-server-2.ts",
    "server:signer-3": "ts-node servers/src/signer-server-3.ts",
    "server:executor": "ts-node servers/src/executor.ts",
    "flow": "ts-node servers/src/index.ts",
    "store:secrets": "ts-node servers/aws/store-secrets-to-aws.ts",
    "fetch:secrets": "ts-node servers/aws/fetch-secrets.ts",
    "test": "jest"
