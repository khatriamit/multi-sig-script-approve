  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.700.0",
    "@safe-global/protocol-kit": "^4.1.0",
    "@safe-global/api-kit": "^2.5.0",
    "@safe-global/safe-core-sdk-types": "^5.1.0",
    "ethers": "^6.11.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
