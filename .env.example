# RPC Configuration
RPC_URL=https://rpc.ankr.com/eth_sepolia
CHAIN_ID=11155111

# Safe Address (leave empty to deploy new Safe)
SAFE_ADDRESS=

# Signer 1 (Required)
SIGNER_1_PRIVATE_KEY=0x...
SIGNER_1_ADDRESS=0x...

# Signer 2 (Required)
SIGNER_2_PRIVATE_KEY=0x...
SIGNER_2_ADDRESS=0x...

# Signer 3 (Required)
SIGNER_3_PRIVATE_KEY=0x...
SIGNER_3_ADDRESS=0x...

# AWS Secrets Manager (optional – use instead of SIGNER_* above)
USE_AWS_SECRETS=1
AWS_SIGNERS_SECRET_PREFIX=multisig/production
AWS_REGION=us-east-1

# Multi-chain Configuration (optional)
ETH_RPC=https://rpc.ankr.com/eth
ETH_SAFE=0x...

ARB_RPC=https://rpc.ankr.com/arbitrum
ARB_SAFE=0x...

OP_RPC=https://rpc.ankr.com/optimism
OP_SAFE=0x...

BASE_RPC=https://rpc.ankr.com/base
BASE_SAFE=0x...

POLYGON_RPC=https://rpc.ankr.com/polygon
POLYGON_SAFE=0x...

# Polygon Amoy testnet (used by coordinator / signers / executor)
POLYGON_AMOY_RPC=https://rpc-amoy.polygon.technology
POLYGON_AMOY_SAFE=0x...
POLYGON_TEST_tUSDC=0x...
POLYGON_AMOY_TX_SERVICE_URL=https://safe-transaction-polygon-amoy.safe.global/api


# Approve 
APPROVE_AMOUNT=
TRANSFER_AMOUNT=
RECIPIENT_ADDRESS=